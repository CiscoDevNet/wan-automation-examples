meta {
  name: 06 - Create System Parcel - Logging
  type: http
  seq: 6
}

post {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/system/{{systemProfileId}}/logging
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno_edge_logging",
    "description": "Do not modify!",
    "data": {
      "disk": {
        "file": {
          "diskFileSize": {
            "optionType": "default",
            "value": 10
          },
          "diskFileRotate": {
            "optionType": "default",
            "value": 10
          }
        }
      }
    }
  }
}
