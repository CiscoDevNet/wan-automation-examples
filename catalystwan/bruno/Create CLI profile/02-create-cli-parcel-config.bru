meta {
  name: 02 - Create CLI Parcel - Config
  type: http
  seq: 2
}

post {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/cli/{{cliProfileId}}/config
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno_edge_cli",
    "description": "Do not modify!",
    "data": {
      "config": "platform console serial"
    }
  }
}
