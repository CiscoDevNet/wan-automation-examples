meta {
  name: List all System Profiles
  type: http
  seq: 1
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

get {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/system/
  body: none
  auth: inherit
}

params:query {
  :
}

settings {
  encodeUrl: true
  timeout: 0
}

script:post-response {
  const body = res.getBody();
  const profiles = body.data || body.items || body;
  const profile = Array.isArray(profiles) ? profiles.find((item) => (item.name || item.profileName) === "bruno_edge_system") : undefined;
  const id = profile && (profile.id || profile.profileId);
  const uuid = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
  if (uuid.test(id || "")) {
    bru.setEnvVar("systemProfileId", id);
  }
}
