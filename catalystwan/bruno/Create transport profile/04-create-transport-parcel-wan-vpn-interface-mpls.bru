meta {
  name: 04 - Create Transport Parcel - WAN VPN Interface MPLS
  type: http
  seq: 4
}

post {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/transport/{{transportProfileId}}/wan/vpn/{{wanVpnParcelId}}/interface/ethernet
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno_edge_vpn0_mpls",
    "description": "Do not modify!",
    "data": {
      "shutdown": {
