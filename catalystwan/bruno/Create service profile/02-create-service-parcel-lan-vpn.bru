meta {
  name: 02 - Create Service Parcel - LAN VPN
  type: http
  seq: 2
}

post {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/service/{{serviceProfileId}}/lan/vpn
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno_edge_vpn1",
    "description": "Do not modify!",
    "data": {
      "vpnId": {
        "optionType": "global",
        "value": 1
      },
      "name": {
        "optionType": "global",
        "value": "VPN 1"
      },
      "ipv4Route": [
        {
          "prefix": {
            "ipAddress": {
              "optionType": "global",
              "value": "0.0.0.0"
            },
            "subnetMask": {
              "optionType": "global",
              "value": "0.0.0.0"
            }
          },
          "oneOfIpRoute": {
            "vpn": {
              "optionType": "default",
              "value": true
            }
          }
        }
      ],
      "dnsIpv4": {
        "primaryDnsAddressIpv4": {
          "optionType": "global",
          "value": "172.16.1.254"
        },
        "secondaryDnsAddressIpv4": {
          "optionType": "global",
          "value": "1.1.1.1"
        }
      },
      "enableSdra": {
        "optionType": "global",
        "value": false
      }
    }
  }
}

script:post-response {
  const body = res.getBody();
  const parcelId = body.parcelId || body.id;
  if (!parcelId) {
    throw new Error("Response did not include parcelId or id");
  }
  bru.setEnvVar("lanVpnParcelId", parcelId);
}
