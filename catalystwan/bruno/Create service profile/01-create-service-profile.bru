meta {
  name: 01 - Create Service Profile
  type: http
  seq: 1
}

post {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/service
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno_edge_lan",
    "description": "Do not modify!"
  }
}

script:post-response {
  const body = res.getBody();
  const id = body.id || body.profileId;
  const uuid = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
  if (!uuid.test(id || "")) {
    throw new Error(`Create Service Profile did not return a valid UUID: ${JSON.stringify(body)}`);
  }
  bru.setEnvVar("serviceProfileId", id);
}
