meta {
  name: 08 - Delete Bruno Service Profile
  type: http
  seq: 8
}

docs {
  Deletes the Service Feature Profile identified by `cleanServiceProfileId`.

  Run `07 - List Bruno Service Profiles` first so the environment variable is populated.

  If `cleanServiceProfileCount` is greater than 1, rerun the list/delete pair until no `bruno_edge_` Service profiles remain.
}

delete {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/service/{{cleanServiceProfileId}}
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

script:pre-request {
  const id = bru.getEnvVar("cleanServiceProfileId");
  const uuid = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
  if (!uuid.test(id || "")) {
    throw new Error("cleanServiceProfileId is missing. Run '07 - List Bruno Service Profiles' first.");
  }
}

script:post-response {
  bru.setEnvVar("cleanServiceProfileId", "");
}
