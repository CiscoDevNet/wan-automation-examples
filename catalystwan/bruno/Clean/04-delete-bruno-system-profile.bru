meta {
  name: 04 - Delete Bruno System Profile
  type: http
  seq: 4
}

docs {
  Deletes the System Feature Profile identified by `cleanSystemProfileId`.

  Run `03 - List Bruno System Profiles` first so the environment variable is populated.

  If `cleanSystemProfileCount` is greater than 1, rerun the list/delete pair until no `bruno_edge_` System profiles remain.
}

delete {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/system/{{cleanSystemProfileId}}
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

script:pre-request {
  const id = bru.getEnvVar("cleanSystemProfileId");
  const uuid = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
  if (!uuid.test(id || "")) {
    throw new Error("cleanSystemProfileId is missing. Run '03 - List Bruno System Profiles' first.");
  }
}

script:post-response {
  bru.setEnvVar("cleanSystemProfileId", "");
}
