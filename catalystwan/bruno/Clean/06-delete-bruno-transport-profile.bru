meta {
  name: 06 - Delete Bruno Transport Profile
  type: http
  seq: 6
}

docs {
  Deletes the Transport Feature Profile identified by `cleanTransportProfileId`.

  Run `05 - List Bruno Transport Profiles` first so the environment variable is populated.

  If `cleanTransportProfileCount` is greater than 1, rerun the list/delete pair until no `bruno_edge_` Transport profiles remain.
}

delete {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/transport/{{cleanTransportProfileId}}
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

script:pre-request {
  const id = bru.getEnvVar("cleanTransportProfileId");
  const uuid = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
  if (!uuid.test(id || "")) {
    throw new Error("cleanTransportProfileId is missing. Run '05 - List Bruno Transport Profiles' first.");
  }
}

script:post-response {
  bru.setEnvVar("cleanTransportProfileId", "");
}
