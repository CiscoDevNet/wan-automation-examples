meta {
  name: 03 - List Bruno System Profiles
  type: http
  seq: 3
}

docs {
  Lists SD-WAN System Feature Profiles and finds profiles whose name starts with the cleanup prefix.

  The prefix comes from the `clean_name_prefix` environment variable and defaults to `bruno_edge_`.

  This request saves:
  - `cleanSystemProfileCount`: number of matching System profiles
  - `cleanSystemProfileId`: first matching System profile ID, used by the next delete request

  Run this after the Bruno Configuration Groups have been removed.
}

get {
  url: https://{{vmanage}}:{{port}}/dataservice/v1/feature-profile/sdwan/system/
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{X-XSRF-TOKEN}}
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
}

script:post-response {
  const prefix = bru.getEnvVar("clean_name_prefix") || "bruno_edge_";
  const body = res.getBody();
  const profiles = body.data || body.items || body;
  const matches = Array.isArray(profiles) ? profiles.filter((item) => (item.name || item.profileName || "").startsWith(prefix)) : [];
  const first = matches[0];

  bru.setEnvVar("cleanSystemProfileCount", String(matches.length));
  bru.setEnvVar("cleanSystemProfileId", first ? (first.id || first.profileId || "") : "");
}
