meta {
  name: Put Policy Group - Varibles
  type: http
  seq: 6
}

put {
  url: https://{{apigwurl}}/dataservice/v1/policy-group/{{policygroup_id}}/device/variables
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
  X-XSRF-TOKEN: {{xsrf-token}}
}

body:json {
  {
      "solution": "sdwan",
      "devices": [
          {
              "device-id": "C1111-8PWE-FCZ2504R2BA",
              "variables": [
                  {
                      "name": "tracker_Src_IP",
                      "value": "192.168.126.5"
                  }
              ]
          }
      ]
  }
}

vars:pre-request {
  policygroup_id: 5aa455de-cd06-4c94-82c7-bae58b608335
}

settings {
  encodeUrl: false
  timeout: 0
}
