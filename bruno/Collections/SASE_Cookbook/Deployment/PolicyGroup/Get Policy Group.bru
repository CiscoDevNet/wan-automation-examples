meta {
  name: Get Policy Group
  type: http
  seq: 2
}

get {
  url: https://{{apigwurl}}/dataservice/v1/policy-group/{{policygroup_id}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
  X-XSRF-TOKEN: {{xsrf-token}}
}

vars:pre-request {
  policygroup_id: 5aa455de-cd06-4c94-82c7-bae58b608335
}

settings {
  encodeUrl: false
  timeout: 0
}
