meta {
  name: Deploy Policy Group
  type: http
  seq: 8
}

post {
  url: https://{{apigwurl}}/dataservice/v1/policy-group/{{policygroup_id}}/device/deploy
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
  X-XSRF-TOKEN: {{xsrf-token}}
}

body:json {
  {
      "devices": [
          {
              "id": "C1111-8PWE-FCZ2504R2BA"
          }
      ]
  }
}

vars:pre-request {
  policygroup_id: 5aa455de-cd06-4c94-82c7-bae58b608335
}

settings {
  encodeUrl: false
  timeout: 0
}
