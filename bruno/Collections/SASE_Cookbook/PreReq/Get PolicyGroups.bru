meta {
  name: Get PolicyGroups
  type: http
  seq: 2
}

get {
  url: https://{{apigwurl}}/dataservice/v1/policy-group
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{apikey}}
  Content-Type: application/json
  X-XSRF-TOKEN: {{xsrf-token}}
}

settings {
  encodeUrl: false
  timeout: 0
}
